# ─── Locket Uploader – Environment Variables ────────────────────────────────
# Sao chép file này thành .env và điền giá trị thật (lấy từ Mitmproxy / Burp Suite)
# KHÔNG bao giờ commit file .env lên Git!

# ── Firebase Config ──────────────────────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_GMPID=1:641029076083:ios:xxxxxxxxxxxxxxxx
FIREBASE_GMPID_STORAGE=1:641029076083:ios:xxxxxxxxxxxxxxxx

# ── Firebase Tokens (cập nhật khi hết hạn) ──────────────────────────────────
FIREBASE_APP_CHECK=eyJraWQiOiJ...your_token_here
FIREBASE_CLIENT=H4sIAAAA...your_client_here
INSTANCE_ID_TOKEN=your_instance_id_token_here

# ── User Agent ────────────────────────────────────────────────────────────────
USER_AGENT=FirebaseAuth.iOS/10.23.1 com.locket.Locket/2.8.0 iPhone/18.0 hw/iPhone12_1
STORAGE_USER_AGENT=com.locket.Locket/1.43.1 iPhone/17.3 hw/iPhone15_3 (GTMSUF/1)

# ── Server Security ───────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:8767
PORT=8767
